### CREATE TRIP
POST {{baseUrl}}/trips
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Trip to the moon",
  "startDate": "2025-12-15",
  "endDate": "2025-12-16",
  "budget": {
    "total": 1000
  },
  "destinations": ["Moon", "Mars", "Jupiter"]
}

### GET ALL TRIPS
GET {{baseUrl}}/trips
Authorization: Bearer {{token}}

### GET TRIP BY ID
GET {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

### UPDATE TRIP BY ID
PATCH {{baseUrl}}/trips/{{tripId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Trip to the moon and back",
  "budget": {
    "total": 1500
  }
}

### DELETE TRIP BY ID
DELETE {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

### CREATE BAGGAGE
POST {{baseUrl}}/{{tripId}}/baggages
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Jacket"
}

### SEND TRIP INvITATION
POST {{baseUrl}}/trips/{{tripId}}/invite
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "collaboratorEmails": [
    "sipendrachaudhary1@gmail.com"
  ]
}

### ACCEPT TRIP INVITATION
GET {{baseUrl}}/trips/{{tripId}}/invite/accept?token={{tripToken}}
Authorization: Bearer {{token}}